# BhoomiAI Backend — Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# JWT Secret — change this to a long random string in production!
JWT_SECRET=bhoomi_my_secret_key_2026
JWT_EXPIRES_IN=24h

# Database (SQLite file path)
DB_PATH=./db/bhoomi.sqlite

# Anthropic API Key (for AI features)
ANTHROPIC_API_KEY=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

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS — your frontend URL
FRONTEND_URL=http://127.0.0.1:5500

# Rate limiting
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=100
